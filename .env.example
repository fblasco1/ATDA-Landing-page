# ATDA local (recomendado :3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=t61vrots
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_WEBHOOK_SECRET=

# Neon Postgres (socios / afiliación / cuotas)
# Creá un proyecto en https://neon.tech y pegá la connection string.
# Luego: npm run db:migrate  (o npm run db:push en desarrollo)
DATABASE_URL=
# Monto por defecto de la primera cuota al aprobar (en centavos). 0 = a definir.
MEMBERSHIP_FEE_CENTS=0

# MODO (Botón / QR) + Decidir Plus (Payway)
# Credenciales que envía MODO tras el onboarding (Username, Password, Store ID).
# Activa el checkout online. Dejar vacío / false hasta cerrar la integración.
MODO_CHECKOUT_ENABLED=false
MODO_ENV=sandbox
MODO_USERNAME=
MODO_PASSWORD=
MODO_STORE_ID=
# Códigos de la configuración comercial / gateway Decidir Plus que te asigna MODO
MODO_PROCESSOR_CODE=
MODO_CC_CODE=1CSI
# Opcional: override de URL de API
# MODO_API_BASE_URL=https://ecommerce.preprod.modo.com.ar

# Auth.js / Google
AUTH_SECRET=
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=admin@atda.org.ar
